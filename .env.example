# TokenProp Environment Variables
# ================================
# COPY this file to .env and fill in values
# NEVER commit .env to Git (it contains your private key!)

# 📚 LEARN: Your MetaMask private key is used to sign deployment transactions.
# Get it from: MetaMask → Account → 3 dots → Account Details → Export Private Key
# ⚠️ NEVER share your private key with anyone!
DEPLOYER_PRIVATE_KEY=your_private_key_here

# 📚 LEARN: RPC URL is the "door" to the blockchain.
# Polygon Amoy testnet (replaced Mumbai in 2024):
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Optional: Polygonscan API key to verify contracts publicly (free at polygonscan.com)
POLYGONSCAN_API_KEY=

# Backend server port
PORT=3001

# 📚 LEARN: After deploying, paste your contract addresses here
# so the frontend knows where to find them on the blockchain
PROPERTY_REGISTRY_ADDRESS=
PROPERTY_TOKEN_ADDRESS=
RENT_DISTRIBUTOR_ADDRESS=
GOVERNANCE_DAO_ADDRESS=
